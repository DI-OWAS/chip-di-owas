	branch = owas_apmemory_verification
[submodule "vendor/tulip"]
	path = vendor/tulip
	url = https://github.com/di-owas/tulip
	ignore = dirty
[submodule "vendor/efpga_subsystem"]
	path = vendor/efpga_subsystem
