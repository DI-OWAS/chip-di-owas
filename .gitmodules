[submodule "vendor/neorv32"]
	path = vendor/neorv32
	url = https://github.com/stnolting/neorv32
	ignore = dirty
[submodule "vendor/FABulous"]
	path = vendor/FABulous
	url = https://github.com/FPGA-Research-Manchester/FABulous
	ignore = dirty
[submodule "vendor/verilog-axi"]
	path = vendor/verilog-axi
	url = https://github.com/alexforencich/verilog-axi.git
	ignore = dirty
[submodule "vendor/IHP-Open-PDK"]
	path = vendor/IHP-Open-PDK
	url = https://github.com/IHP-GmbH/IHP-Open-PDK.git
	ignore = dirty
[submodule "vendor/QSPI_Memory_Controller"]
	path = vendor/QSPI_Memory_Controller
