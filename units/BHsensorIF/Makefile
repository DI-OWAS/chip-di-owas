.DEFAULT_GOAL := help

# ==================
# = Project Layout =
# ==================

# Directories
topdir  = $(CURDIR)

# ===============
# = HDL sources =
# ===============

MODULE_NAME = BHsensorIF

TBFILES = 

COREFILES_VERILOG_LIST = $(shell cat src/$(MODULE_NAME).v.f)
COREFILES_VERILOG = $(subst TOPDIR, $(topdir), $(COREFILES_VERILOG_LIST))

COREFILES_VHDL_LIST = $(shell cat src/$(MODULE_NAME).vhd.f)
COREFILES_VHDL = $(subst TOPDIR, $(topdir), $(COREFILES_VHDL_LIST))
COREFILES_VHDL_TOP_ENTITY = BHsensorIF_top

# Auto-generate all-Verilog IP module
CORE_VLG = $(topdir)/src/rtl/$(COREFILES_VHDL_TOP_ENTITY).autogenerated.v

# ===============
# = RTL targets =
# ===============

$(CORE_VLG):
	@echo "Converting IP module to Verilog ($(CORE_VLG)) ..."
	apptainer exec --bind /usr/local/share/pdk --writable-tmpfs /librelane.img bash -c \
		"source /result/entrypoint; yosys -m ghdl -p 'ghdl --std=08 --work=work $(COREFILES_VHDL) -e $(COREFILES_VHDL_TOP_ENTITY); \
		 select -count a:init; opt_clean; write_verilog -noattr $@'"

vhdl_to_verilog: $(CORE_VLG)

check_tools:
	@echo "Checking tools ..."
	@echo "[GHDL]"
	@ghdl -v
	@echo "[Tool check OK]"

# =============================
# = General helpers and tools =
# =============================

help:
	@echo "-----------------------------------------"
	@echo "DI-OWAS Conversion Makefile              "
	@echo "-----------------------------------------"
	@echo "General targets:"
	@echo " help  - show this text"
	@echo " info  - show Makefile configuration"
	@echo " clean - remove all local build artifacts"
	@echo ""
	@echo "RTL and verification targets:"
	@echo " vhdl_to_verilog - convert VHDL core files to a single Verilog module"
	@echo ""

info:
	@echo "-----------------------------------------"
	@echo "DI-OWAS Conversion Makefile Configuration"
	@echo "-----------------------------------------"
	@echo "COREFILES_VHDL    = $(COREFILES_VHDL)"
	@echo "COREFILES_VERILOG = $(COREFILES_VERILOG)"
	@echo "TOPDIR            = $(topdir)"
	@echo "CORE_VLG          = $(CORE_VLG)"

clean:
	rm -f $(CORE_VLG)

