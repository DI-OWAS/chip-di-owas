## Abstract      : DI-OWAS CPU-complex main makefile

.DEFAULT_GOAL := help

# ==================
# = Project layout =
# ==================

# Directories
topdir = $(CURDIR)
incdir = $(topdir)/../vendor/neorv32/rtl/core $(topdir)/rtl

# Top modules
CONFIGOPTIONS =
TOPMODULE     = core_complex_top

# ===============
# = HDL sources =
# ===============

TBFILES = $(tbdir)/core_complex_top_tb.v $(tbdir)/uart_sim_receiver.v

COREFILES_VERILOG_LIST = $(shell cat src/$(TOPMODULE).v.f)
COREFILES_VERILOG = $(subst TOPDIR, $(topdir), $(COREFILES_VERILOG_LIST))

COREFILES_VHDL_LIST = $(shell cat src/$(TOPMODULE).vhd.f)
COREFILES_VHDL = $(subst TOPDIR, $(topdir), $(COREFILES_VHDL_LIST))
COREFILES_VHDL_TOP_ENTITY = core_complex_wrapper

# Auto-generate all-Verilog RISC-V core module
RISCV_CORE_VLG = $(topdir)/src/rtl/$(COREFILES_VHDL_TOP_ENTITY).autogenerated.v

HDLFILES = $(COREFILES_VERILOG) $(COREFILES_VHDL) $(CONFIGFILES) $(TBFILES)

# ================================
# = RTL and verification targets =
# ================================

$(RISCV_CORE_VLG):
	@echo "Converting IP module to Verilog ($(CORE_VLG)) ..."
	apptainer exec --bind /usr/local/share/pdk --writable-tmpfs /librelane.img bash -c \
		"source /result/entrypoint; yosys -m ghdl -p 'ghdl --std=08 --work=neorv32 $(COREFILES_VHDL) -e $(COREFILES_VHDL_TOP_ENTITY); \
		 select -count a:init; opt_clean; write_verilog -noattr $@'"

vhdl_to_verilog: $(RISCV_CORE_VLG)

check_tools:
	@echo "Checking tools ..."
	@echo "[GHDL]"
	@ghdl -v
	@echo "[Icarus Verilog]"
	@iverilog -V
	@echo ""
	@echo "[RISC-V GCC]"
	@riscv-none-elf-gcc -v
	@echo ""
	@echo "[singularity (apptainer)]"
	@singularity --version
	@echo ""
	@echo "[Tool check OK]"

check_core:
	@echo "Checking RISC-V processor core (processor-local testbench and test application) using GHDL ..."
	@make -C $(topdir)/../../vendor/neorv32/sw/example/processor_check USER_FLAGS+="-DUART0_SIM_MODE -DUART1_SIM_MODE" clean_all check info all sim-check

# =============================
# = General helpers and tools =
# =============================

help:
	@echo "-----------------------------------------"
	@echo " DI-OWAS - FhG IMS Core-Complex Makefile "
	@echo "-----------------------------------------"
	@echo "General targets:"
	@echo " help  - show this text"
	@echo " info  - show Makefile configuration"
	@echo " clean - remove all local build artifacts"
	@echo ""
	@echo "RTL and verification targets:"
	@echo " vhdl_to_verilog - convert VHDL core files to a single Verilog module"
	@echo " check_tools     - check tools required for verification/infrastructure"
	@echo " check_core      - run the default processor core testbench"

info:
	@echo "-------------------------------------------"
	@echo "DI-OWAS Core-Complex Makefile Configuration"
	@echo "-------------------------------------------"
	@echo "COREFILES_VHDL    = $(COREFILES_VHDL)"
	@echo "COREFILES_VERILOG = $(COREFILES_VERILOG)"
	@echo "TBFILES           = $(TBFILES)"
	@echo "TOPDIR            = $(topdir)"

clean:
	rm -f $(topdir)/*.v \
	rm -f $(topdir)/*.vhd \
	rm -f $(topdir)/*.cf \
	rm -f $(topdir)/*.log \
	rm -f $(RISCV_CORE_VLG)
