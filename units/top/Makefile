## Abstract      : DI-OWAS top main makefile

.DEFAULT_GOAL := help

SIMULATOR ?= iverilog

# ====================
# = Unit RTL sources =
# ====================

RTL_AXI = ../../vendor/verilog-axi/rtl/*.v

RTL_CORECOMPLEX = ../core_complex/src/rtl/*.v \

RTL_SRAM = ../sram/src/rtl/*.v

EFPGA_MIRROR_DIR = ../../vendor/efpga_subsystem/VERILOG_MIRROR_GENERATED
RTL_EFPGA_LIST = $(shell grep -v '^[[:space:]]*#' $(EFPGA_MIRROR_DIR)/FILE_LISTS/efpga_subsystem.f)
RTL_EFPGA = $(addprefix $(EFPGA_MIRROR_DIR)/, $(RTL_EFPGA_LIST))

RTL_SPIRAM = ../spiram/src/rtl/spiram_controller_axi.autogenerated.v

RTL_OCTRAM = ../../vendor/QSPI_Memory_Controller/src/*.v

RTL_BHORIZON = \
../BHsensorIF/src/rtl/BHsensorIF_top.autogenerated.v \
../BHsensorIF/src/rtl/BHsensorIF_axi_dma_wr.v

RTL_DCVISION = ../dc_camera_if/src/rtl/dc_cam_if_top.autogenerated.v

RTL_CRYPTO = ../crypto_core/src/rtl/*.v

RTL_TOP = src/rtl/diowas_top.v

RTL_TOP_ASIC = src/rtl/diowas_top_pads.v

# =====================
# = Global file lists =
# =====================

PDK_ROOT ?= ../../vendor/IHP-Open-PDK

FILES_RTL = \
$(RTL_TOP) \
$(RTL_DCCAMERAIF) \
$(RTL_BHORIZON) \
$(RTL_DCVISION) \
$(RTL_CRYPTO) \
$(RTL_AXI) \
$(RTL_SRAM) \
$(RTL_CORECOMPLEX) \
$(RTL_SPIRAM) \
$(RTL_OCTRAM) \
$(RTL_EFPGA) \
$(PDK_ROOT)/ihp-sg13g2/libs.ref/sg13g2_sram/verilog/*.v

FILES_ASIC = \
$(RTL_TOP_ASIC) \
$(PDK_ROOT)/ihp-sg13g2/libs.ref/sg13g2_io/verilog/*.v

FILES_SIM = \
src/sim/diowas_top_tb.v \
src/sim/uart_rtx.v \
src/sim/spi_rom.v \
src/sim/bfm_imager.sv \
src/sim/psram.v

INC_SIM = \src/sim

# ================================
# = openlane ASIC implementation =
# ================================

.PHONY: openlane
openlane: $(RISCV_CORE_VLG)
	make -C ../.. TERM=xterm OWAS_CONTAINER=$(PWD)/../../owas.img

# =========================
# = FPGA targets (Vivado) =
# =========================
fpga_project: vhdl_to_verilog
	make -C fpga project

fpga_gui:
	make -C fpga gui

fpga_bitstream:
	make -C fpga bitstream

fpga_clean:
	make -C fpga clean

# ========================================================
# = Convert VHDl to Verilog; add other units as required =
# ========================================================
vhdl_to_verilog:
	@if [ ! -f $(EFPGA_MIRROR_DIR)/FILE_LISTS/efpga_subsystem.f ]; then \
		../../vendor/efpga_subsystem/scripts/generate_verilog_mirror.sh -e none; \
	fi
	make -C ../core_complex vhdl_to_verilog
	make -C ../spiram vhdl_to_verilog
	make -C ../dc_camera_if vhdl_to_verilog
	make -C ../BHsensorIF vhdl_to_verilog

# ===============================
# = Verification / test targets =
# ===============================
check_tools:
	make -C ../core_complex check_tools

test: check_tools vhdl_to_verilog
	@echo "Running top testbench using Icarus Verilog ..."

sim_fpga: vhdl_to_verilog
	@echo "Compiling HDL sources (iverilog) ..."
	@iverilog -DTECH_FPGA=1 -DFUNCTIONAL=1 -DWAVEDUMP=1 -g2012 -Wall -s diowas_top_tb -o sim_fpga.icarus.sim $(FILES_SIM) $(FILES_RTL) -I $(INC_SIM)
	@echo "Running FPGA/plain RTL simulation (iverilog) ..."
	@touch sim_fpga.icarus.log
	@vvp sim_fpga.icarus.sim
	@echo "Checking simulation logs ..."
	@cat sim_fpga.icarus.log
	@grep 'TB: Simulation successful!' sim_fpga.icarus.log

sim_asic: vhdl_to_verilog
	@echo "Compiling HDL sources (iverilog) ..."
	@iverilog -DFUNCTIONAL=1 -DWAVEDUMP=1 -g2012 -Wall -s diowas_top_tb -o sim_asic.icarus.sim $(FILES_SIM) $(FILES_RTL) $(FILES_ASIC) -I $(INC_SIM)
	@echo "Running ASIC simulation (iverilog) ..."
	@touch sim_asic.icarus.log
	@vvp sim_asic.icarus.sim | tee sim_asic.icarus.log
	@echo "Checking simulation logs ..."
	@cat sim_asic.icarus.log
	@grep 'TB: Simulation successful!' sim_asic.icarus.log

# =============================
# = General helpers and tools =
# =============================

help:
	@echo "-----------------------------"
	@echo " DI-OWAS - Top Main Makefile "
	@echo "-----------------------------"
	@echo "General targets:"
	@echo " help            - show this text"
	@echo " info            - show configuration/variables"
	@echo " clean           - remove all local build artifacts"
	@echo " patch           - apply submodule patches"
	@echo ""
	@echo "RTL targets:"
	@echo " vhdl_to_verilog - convert VHDL core files to a single Verilog module"
	@echo ""
	@echo "Test targets:"
	@echo " check_tools     - check available tools required for ALL units"
	@echo ""
	@echo "Simulation targets:"
	@echo " sim_fpga        - run the default testbench (for FPGA/plain RTL techn)"
	@echo " sim_asic        - run the default testbench (for ASIC)"
	@echo ""
	@echo "FPGA emulation targets (Vivado):"
	@echo " fpga_project    - (re-)create Vivado project"
	@echo " fpga_gui        - open Vivado project in GUI mode"
	@echo " fpga_bitstream  - generate bitstream (in console mode)"
	@echo " fpga_clean      - remove all FPGA artifacts"

info:
	@echo "-------------------------"
	@echo " RTL files "
	@echo "-------------------------"
	@echo "RTL_CORECOMPLEX = $(RTL_CORECOMPLEX)"
	@echo "RTL_AXI         = $(RTL_AXI)"
	@echo "RTL_EFPGA       = $(RTL_EFPGA)"
	@echo "RTL_SPIRAM      = $(RTL_SPIRAM)"
	@echo "RTL_OCTRAM      = $(RTL_OCTRAM)"
	@echo "RTL_BHORIZON    = $(RTL_BHORIZON)"
	@echo "RTL_DCVISION    = $(RTL_DCVISION)"
	@echo "RTL_TOP         = $(RTL_TOP)"

patch:
	@echo "Patching submodules..."
	@git -C ../../vendor/verilog-axi apply --reverse --check $(CURDIR)/verilog-axi.patch 2>/dev/null || \
		git -C ../../vendor/verilog-axi apply $(CURDIR)/verilog-axi.patch
	@touch patch

clean: fpga_clean
	make -C ../core_complex clean
	make -C ../spiram clean
	make -C ../dc_camera_if clean
	make -C ../BHsensorIF clean
	make -C ../dc_camera_if clean
	rm -f *.log *.sim
