# Recreate the DI-OWAS top test setup for the Digilent Nexys Video FPGA board
# author: nolting, FhG IMS, 2025


# Project configuration
set part "xc7a200tsbg484-1"
set prj nexys_video
set outputdir work
set script_path [ file dirname [ file normalize [ info script ] ] ]
set home_path [ file dirname $script_path ]


# Create and clear output/work directory
file mkdir $outputdir

set files [glob -nocomplain "$outputdir/*"]
if {[llength $files] != 0} {
    puts "deleting contents of $outputdir"
    file delete -force {*}[glob -directory $outputdir *]; # clear folder contents
} else {
    puts "$outputdir is clean"
}


# Create new Vivado project
create_project -part $part $prj $outputdir
set_property PART ${part} [current_project]
#set_property strategy Flow_AreaOptimized_high [get_runs synth_1]
#set_property STEPS.SYNTH_DESIGN.ARGS.FLATTEN_HIERARCHY none [get_runs synth_1]
#set_property STEPS.SYNTH_DESIGN.ARGS.GLOBAL_RETIMING off [get_runs synth_1]

# Add FPGA top
add_file nexys_video.v

# Add constraints file(s)
set fileset_constraints [glob *.xdc]
add_files -fileset constrs_1 $fileset_constraints

# Auto-generate processor module (verilog)
add_file ./../../core_complex/src/rtl/core_complex_wrapper.autogenerated.v
add_file ./../../core_complex/src/rtl/core_complex_top.v

# Add AXI infrastructure
add_files [glob ./../../../vendor/verilog-axi/rtl/*.v]

## # Add eFPGA and enable out-of-context syntheiss
## set efpga_file_list_file [read [open "./../../efpga/src/filelist.f" r]]
## set efpga_file_list [string map [list "TOPDIR" "./../../efpga/src"] $efpga_file_list_file]
## add_files $efpga_file_list

# Auto-generated SPI PSRAM controller
add_file ./../../spiram/src/rtl/spiram_controller_axi.autogenerated.v

# Octal PSRAM controller
add_files [glob ./../../../vendor/QSPI_Memory_Controller/src/*.v]

# Auto-generated B-Horizon sensor interface
add_file ./../../BHsensorIF/src/rtl/BHsensorIF_top.autogenerated.v
add_file ./../../BHsensorIF/src/rtl/BHsensorIF_axi_dma_wr.v

# Auto-generated DC-Vision camera interface
add_file ./../../dc_camera_if/src/rtl/dc_cam_if_top.autogenerated.v

# RUB Crypto Core
add_files [glob ./../../crypto_core/src/rtl/*.v]

# Add on-chip SRAM
add_file ./../../sram/src/rtl/spram_ihp130nm.v
add_files -fileset sim_1 [glob ./../../../vendor/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_sram/verilog/*.v]
add_files -fileset sim_1 [glob ./../../../vendor/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_io/verilog/*.v]

# Add DIOWAS chip top
add_file ./../src/rtl/diowas_top.v

# Add simulation source
set_property SOURCE_SET sources_1 [get_filesets sim_1]
add_files -fileset sim_1 -norecurse [glob ../../top/src/sim/*.v]
add_files -fileset sim_1 -norecurse ../../top/src/sim/bfm_imager.sv
add_files -fileset sim_1 -norecurse ../../top/src/sim/jtag_tasks.vh
add_files -fileset sim_1 -norecurse ../../top/src/sim/sac2owas.vh
add_files -fileset sim_1 -norecurse ../../top/src/sim/boot_image.mem
update_compile_order -fileset sim_1

# Set top modules
update_compile_order -fileset sources_1
update_compile_order -fileset sim_1
# Disabling source management mode.  This is to allow the top design properties to be set without GUI intervention.
set_property source_mgmt_mode None [current_project]
set_property top nexys_video [current_fileset]
# Re-enabling previously disabled source management mode.
set_property source_mgmt_mode All [current_project]
update_compile_order -fileset sources_1
# Disabling source management mode.  This is to allow the top design properties to be set without GUI intervention.
set_property source_mgmt_mode None [current_project]
set_property top diowas_top_tb [get_filesets sim_1]
set_property top_lib xil_defaultlib [get_filesets sim_1]
# Re-enabling previously disabled source management mode.
set_property source_mgmt_mode All [current_project]
update_compile_order -fileset sim_1

# defines for synthesis and simulation
set_property verilog_define {TECH_FPGA=1} [get_filesets sources_1]
set_property verilog_define {TECH_FPGA=1} [get_filesets sim_1]
set_property INCREMENTAL false [get_filesets sim_1]
